# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- MongoDB -----
# Local Compass / Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017/phone_marketplace
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/phone_marketplace

# ----- CORS -----
CLIENT_ORIGIN=http://localhost:5173

# ----- LLM (Groq, free tier) -----
# Get a free key at https://console.groq.com (no credit card)
# Leave blank to fall back to the rule-based chatbot.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
